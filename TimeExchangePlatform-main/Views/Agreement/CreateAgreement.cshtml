@using TimeExchangePlatform.ViewModels
@model CreateAgreementViewModel

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Create Agreement</title>

    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"
          rel="stylesheet">
</head>
<body class="bg-light">

<div class="container vh-100 d-flex justify-content-center align-items-center">
    <div class="card shadow-sm" style="max-width: 420px; width: 100%;">
        <div class="card-body p-4">
            <h3 class="card-title text-center mb-4">Agreement</h3>

            <form asp-controller="Agreement"
                  asp-action="CreateAgreement"
                  method="post">

                <input type="hidden" asp-for="OfferId" />

                <div class="mb-3">
                    <label asp-for="Hours" class="form-label"></label>
                    <input asp-for="Hours" class="form-control" />
                    <span asp-validation-for="Hours" class="text-danger small"></span>
                </div>

                <div class="d-flex gap-2 mt-4">
                    <button type="submit" class="btn btn-primary w-100">
                        Send request
                    </button>

                    <a asp-controller="Offers"
                       asp-action="OfferDetails"
                       asp-route-id="@Model.OfferId"
                       class="btn btn-outline-secondary w-100">
                        Cancel
                    </a>
                </div>

            </form>
        </div>
    </div>
</div>

</body>
</html>
