@model Offer

<h2>@Model.Title</h2>

<p> <strong>Category:</strong> @Model.Category</p>
<p> <strong>Description:</strong> @Model.Description</p>
<p> <strong>Author:</strong> @Model.User?.UserName</p>

<hr />

<form asp-controller="Agreement"
asp-action="CreateAgreement"
method="post">

<input type="hidden" name="offerId" value="@Model.Id" />
<a asp-controller="Agreement" asp-action="CreateAgreement" class="btn btn-primary">Exchange</a>

</form>

<a asp-action ="Index">Back to offers</a>

