@model List<Offer>

<style>
    body {
        background-color: #f5f7fa;
    }

    .page-container {
        max-width: 900px;
        margin: 50px auto;
    }

    .page-title {
        text-align: center;
        font-weight: 600;
        margin-bottom: 25px;
    }

    .offers-card {
        background: #ffffff;
        border-radius: 12px;
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.05);
        padding: 25px;
    }

    .table th {
        font-weight: 600;
        background-color: #f1f3f5;
    }

    .table td,
    .table th {
        vertical-align: middle;
    }

    .offer-link {
        font-weight: 500;
        text-decoration: none;
    }

    .offer-link:hover {
        text-decoration: underline;
    }

    .btn {
        border-radius: 8px;
    }

    .actions {
        text-align: center;
    }

    .bottom-actions {
        margin-top: 25px;
        text-align: center;
    }
</style>

<div class="page-container">
    <h2 class="page-title">Offers</h2>

    <div class="offers-card">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>Title</th>
                    <th>Category</th>
                    <th>Created</th>
                    <th class="text-center">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var offer in Model)
                {
                    <tr>
                        <td>
                            <a asp-controller="Offer"
                               asp-action="OfferDetails"
                               asp-route-offerId="@offer.Id"
                               class="offer-link">
                                @offer.Title
                            </a>
                        </td>

                        <td>@offer.Category</td>

                        <td>@offer.CreatedAt.ToShortDateString()</td>

                        <td class="actions">
                            <form asp-controller="Offer"
                                  asp-action="DeleteOffer"
                                  asp-route-offerId="@offer.Id"
                                  method="post"
                                  onsubmit="return confirm('Are you sure you want to delete this offer?');">
                                <button class="btn btn-sm btn-danger">
                                    Delete
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="bottom-actions">
        <a asp-controller="Offer"
           asp-action="CreateOffer"
           class="btn btn-success">
            Create offer
        </a>
    </div>
</div>
