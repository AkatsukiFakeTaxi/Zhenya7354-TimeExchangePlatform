
@{
    ViewData["Title"] = "Email Send";
    Layout = "~/Views/Shared/_AccountLayout.cshtml";
}

<div class=" account-container">
    <div class="account-box">
        <h2 class="text-center mb-4">Email has been sent</h2>
        <p class="text-center mb-4">A verification email has been sent to your email address.
            Please check your inbox and follow the instructions</p>
            <div class="text-center mt-2" >
                <a asp-controller="Account" asp-action="Login" class="text-decoration-none mt-2">Back to Login page</a>
            </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial.cshtml");
    }

}
