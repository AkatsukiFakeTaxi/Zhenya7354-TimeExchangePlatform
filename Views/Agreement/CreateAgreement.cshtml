@using TimeExchangePlatform.ViewModels
@model CreateAgreementViewModel

<h2>Agreement</h2>

<form asp-controller="Agreement"
asp-action="CreateAgreement" method="post">

<input type="hidden" asp-for="OfferId" />

    <div class="mb-3">
        <label asp-for="Hours" class="form-label"></label>
        <input asp-for="Hours" class="form-control" />
        <span asp-validation-for="Hours" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Send request</button>

    <a asp-controller="Offers" asp-action="OfferDetails" asp-route-id="@Model.OfferId"
    class="btn btn-secondary ms-2">Cancel</a> 

</form>